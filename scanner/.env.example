# Kopieren nach .env und anpassen. Alle Variablen beginnen mit TRS_.

# ---- Kursdaten ---------------------------------------------------------------
# yahoo     = kostenlos, ca. 15 min verzögert (Start, Backtests)
# alpaca    = Echtzeit für US-Aktien (kostenloses Konto: IEX-Feed, max. 30 Symbole live)
# synthetic = Demo ohne Internet
TRS_DATA_PROVIDER=yahoo
# TRS_ALPACA_KEY_ID=
# TRS_ALPACA_SECRET_KEY=
# TRS_ALPACA_FEED=iex          # "sip" mit Algo Trader Plus (alle US-Börsen)

# ---- Nachrichten -------------------------------------------------------------
# SEC verlangt einen User-Agent mit Kontaktangabe (Name + E-Mail):
TRS_SEC_USER_AGENT="Mein Name meine@email.de"
# TRS_FINNHUB_API_KEY=         # optional: News + Analysten-Up-/Downgrades
# TRS_REDDIT_CLIENT_ID=        # optional: Reddit-App (Typ "script") für Social-Media-Erwähnungen
# TRS_REDDIT_CLIENT_SECRET=
# Weitere RSS-Feeds, z. B. Ad-hoc-Meldungen (kommagetrennt):
# TRS_EXTRA_RSS_FEEDS=https://.../adhoc.rss
# TRS_SENTIMENT_MODEL=auto     # auto | finbert | vader

# ---- Alarme ------------------------------------------------------------------
# Telegram: Bot bei @BotFather anlegen, Chat-ID z. B. über @userinfobot
# TRS_TELEGRAM_BOT_TOKEN=
# TRS_TELEGRAM_CHAT_ID=
# ntfy (Push-App, kostenlos): eigenes, schwer erratbares Thema wählen
# TRS_NTFY_URL=https://ntfy.sh/mein-geheimes-thema-123
# E-Mail
# TRS_SMTP_HOST=
# TRS_SMTP_PORT=587
# TRS_SMTP_USER=
# TRS_SMTP_PASSWORD=
# TRS_ALERT_EMAIL_TO=

TRS_ALERT_MIN_SCORE=80
TRS_ALERT_MIN_CONFLUENCE=2
TRS_ALERT_COOLDOWN_MINUTES=60
TRS_ALERT_HORIZONS=1h,4h,1d
TRS_SCAN_INTERVAL_SECONDS=300

# ---- Kostenmodell (Trade Republic) -------------------------------------------
TRS_ORDER_FEE_EUR=1.0
TRS_POSITION_SIZE_EUR=1000
